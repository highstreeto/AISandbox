{#
AI Sandbox engine — the template for .state/compose.yml. It is embedded in the app, not written out.
Project settings live in sandbox.toml, the network allowlist in allowlist.txt (both in .sandbox/).
The sandbox app (src/) renders it with the settings from sandbox.toml and this
machine's facts into .state/compose.yml, the one file docker compose / podman compose is started with.

  host browser ──► 127.0.0.1:<port> ──► gateway ──► desktop (KDE)
                                                      │  internal network:
                                                      │  no internet route, no external DNS
                                                      ▼
                                                    proxy (tinyproxy + allowlist) ──► internet

Template syntax: Jinja, rendered by MiniJinja (https://github.com/mitsuhiko/minijinja).
Every text value from sandbox.toml or the host goes through `| q`, which writes it as a quoted
YAML string, so paths and values can't break the YAML. Numbers and true/false are validated
by the app and written as-is. Relative paths are relative to the .sandbox folder (--project-directory).

host.runtime is "docker" or "podman". Podman differences: bind mounts get the SELinux label "z", rootless Podman
keeps the host user's id in the desktop (userns_mode keep-id, so files in the project stay the user's), and NVIDIA
GPUs are a CDI device.

host.nesting ([tools] podman, rootless Podman only): the desktop gets /dev/fuse, /dev/net/tun, label=disable and
unmask=ALL (merged into desktop.devices / desktop.security_opt by the app), a higher pids limit, its own image
storage volume and SANDBOX_INSIDE=1. host.nested (started inside such a desktop): the proxy forwards to the outer
proxy (sandbox-upstream = host.upstream_proxy), and the desktop has no hostname (nested containers share the outer
desktop's UTS namespace).
-#}
# Rendered from compose.yml.j2 with sandbox.toml and this machine's settings.
# Relative paths are relative to the .sandbox folder.
networks:
  sandbox:            # desktop <-> proxy/gateway; NO internet route
    internal: true
  egress: {}          # proxy -> internet
  ui: {}              # gateway -> published localhost port
{% if llm %}
  llm:                # gateway <-> ollama; NO internet route
    internal: true
  llm-egress: {}      # ollama -> model registry (downloads started by "sandbox up" / "sandbox llm pull")
{% endif %}

x-hardened: &hardened
  read_only: true
  cap_drop: [ALL]
  security_opt: ["no-new-privileges:true"]
  restart: unless-stopped
  volumes:
    - {{ ".:/sandbox:ro,z" if host.runtime == "podman" else ".:/sandbox:ro" }}   # allowlist.txt (live: "sandbox reload")

services:
  proxy:
    <<: *hardened
    build: ./.state/proxy
    {% if host.nested %}
    command: ["tinyproxy", "-d", "-c", "/etc/tinyproxy/tinyproxy-nested.conf"]   # Upstream: the outer proxy
    networks: [sandbox, egress]
    extra_hosts:
      - {{ ("sandbox-upstream:" ~ host.upstream_proxy) | q }}
    {% else %}
    command: ["tinyproxy", "-d", "-c", "/etc/tinyproxy/tinyproxy.conf"]
    networks: [sandbox, egress]
    extra_hosts:
      - "host.docker.internal:host-gateway"   # only reachable if allowlisted
    {% endif %}
    healthcheck:
      test: ["CMD", "nc", "-z", "127.0.0.1", "3128"]
      interval: 10s
      timeout: 3s
      retries: 3

  gateway:
    <<: *hardened
    build: ./.state/proxy
    command: ["socat", "TCP-LISTEN:3001,fork,reuseaddr", "TCP:desktop:3001"]
    networks: [sandbox, ui]
    ports:
      - {{ ("127.0.0.1:" ~ host.ui_port ~ ":3001") | q }}
    depends_on: [proxy]

  desktop:
    build:
      context: ./.state/desktop
      args:{{ " {}" if not tools else "" }}
      {% for t in tools %}
        {{ t.arg }}: {{ t.value | q }}
      {% endfor %}
    {% if not host.nested %}
    hostname: sandbox
    {% endif %}
    {% if host.runtime == "podman" and host.rootless %}
    userns_mode: "keep-id"   # the host user's id inside; files written to the project stay theirs
    user: "0:0"              # the image's init starts as root and switches to PUID/PGID
    {% endif %}
    shm_size: 1gb
    labels:
      sandbox.id: {{ host.id | q }}
    environment:
      TITLE: {{ desktop.title | q }}
      SANDBOX_SUDO: {{ desktop.sudo | q }}
      {% if desktop.auth %}
      CUSTOM_USER: {{ desktop.auth.user | q }}
      PASSWORD: {{ desktop.auth.password | q }}
      {% endif %}
      HTTP_PROXY: http://proxy:3128
      HTTPS_PROXY: http://proxy:3128
      http_proxy: http://proxy:3128
      https_proxy: http://proxy:3128
      NO_PROXY: localhost,127.0.0.1,::1{{ ",llm" if llm else "" }}
      no_proxy: localhost,127.0.0.1,::1{{ ",llm" if llm else "" }}
      PUID: {{ host.uid | q }}
      PGID: {{ host.gid | q }}
      {% if desktop.timezone %}
      TZ: {{ desktop.timezone | q }}
      {% endif %}
      SANDBOX_WORKDIR: {{ host.workdir | q }}
      {% if host.nesting %}
      SANDBOX_INSIDE: "1"       # a sandbox started in this desktop is nested
      {% endif %}
      {% if llm %}
      SANDBOX_LLM_URL: "http://llm:11434"
      SANDBOX_LLM_MODEL: {{ llm.model | q }}
      SANDBOX_LLM_CONTEXT: {{ llm.context | q }}
      OLLAMA_HOST: "http://llm:11434"
      {% endif %}
      {% for e in env %}
      {{ e.key | q }}: {{ e.value | q }}
      {% endfor %}
    volumes:
      - home:/config            # persistent home: logins, IDE settings, Toolbox IDEs
      {% if host.nesting %}
      - containers:/config/.local/share/containers   # Podman's images (a volume: overlay can't nest on overlay)
      {% endif %}
      {% for m in mounts %}
      - {type: bind, source: {{ m.source | q }}, target: {{ m.target | q }}, read_only: {{ "true" if m.read_only else "false" }}{{ ", bind: {selinux: z}" if host.runtime == "podman" else "" }}}
      {% endfor %}
    {% if desktop.devices %}
    devices:
      {% for d in desktop.devices %}
      - {{ d | q }}
      {% endfor %}
    {% endif %}
    {% if desktop.security_opt %}
    security_opt:
      {% for o in desktop.security_opt %}
      - {{ o | q }}
      {% endfor %}
    {% endif %}
    networks: [sandbox]
    mem_limit: {{ desktop.memory | q }}
    {% if desktop.cpus %}
    cpus: {{ desktop.cpus }}
    {% endif %}
    pids_limit: {{ 32768 if host.nesting else 4096 }}
    depends_on: [proxy]
    restart: unless-stopped
    healthcheck:
      # Ready = web UI answers AND the KDE shell is running (avoids the
      # "first page load fails" race when the browser opens too early).
      test: ["CMD-SHELL", "curl -skf -o /dev/null https://localhost:3001/ && pgrep -f plasmashell >/dev/null"]
      interval: 5s
      timeout: 5s
      retries: 3
      start_period: 180s

{% if llm %}
  # The local LLM: only the "llm" gateway is reachable from the desktop. It passes inference and read-only
  # endpoints to ollama and logs token usage; pulling models is left to the sandbox app ("sandbox llm pull").
  ollama:
    image: "ollama/ollama:0.40.16{{ "-rocm" if llm.gpu == "amd" else "" }}"
    security_opt: ["no-new-privileges:true"]
    restart: unless-stopped
    environment:
      OLLAMA_HOST: "0.0.0.0:11434"
      OLLAMA_CONTEXT_LENGTH: {{ llm.context | q }}
      {% if llm.keep_alive %}
      OLLAMA_KEEP_ALIVE: {{ llm.keep_alive | q }}
      {% endif %}
      OLLAMA_FLASH_ATTENTION: "1"
      OLLAMA_KV_CACHE_TYPE: "q8_0"
    volumes:
      - models:/root/.ollama    # machine-wide, shared by all projects, kept by "down -v"
    networks: [llm, llm-egress]
    {% if llm.gpu == "nvidia" and host.runtime == "podman" %}
    devices:
      - "nvidia.com/gpu=all"   # CDI (nvidia-ctk cdi generate)
    {% elif llm.gpu == "nvidia" %}
    deploy:
      resources:
        reservations:
          devices:
            - {driver: nvidia, count: all, capabilities: [gpu]}
    {% elif llm.gpu == "amd" %}
    devices:
      - "/dev/kfd:/dev/kfd"
      - "/dev/dri:/dev/dri"
    {% endif %}
    healthcheck:
      test: ["CMD", "ollama", "list"]
      interval: 10s
      timeout: 5s
      retries: 6
      start_period: 20s

  llm:
    <<: *hardened
    build: ./.state/llm
    networks: [sandbox, llm]
    volumes:
      - llm-usage:/var/log/llm
    tmpfs:
      - /tmp
    depends_on:
      ollama:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "wget", "-q", "-O", "/dev/null", "http://127.0.0.1:11434/api/version"]
      interval: 10s
      timeout: 3s
      retries: 3

{% endif %}
volumes:
  home:
{% if host.nesting %}
  containers:
{% endif %}
{% if llm %}
  llm-usage:
  models:
    external: true
    name: sandbox-llm-models
{% endif %}
