{#
AI Sandbox engine — the template for .state/compose.yml. It is embedded in the app, not written out.
Project settings live in sandbox.toml, the network allowlist in allowlist.txt (both in .sandbox/).
The sandbox app (src/) renders it with the settings from sandbox.toml and this
machine's facts into .state/compose.yml, the one file docker compose is started with.

  host browser ──► 127.0.0.1:<port> ──► gateway ──► desktop (KDE)
                                                      │  internal network:
                                                      │  no internet route, no external DNS
                                                      ▼
                                                    proxy (tinyproxy + allowlist) ──► internet

Template syntax: Jinja, rendered by MiniJinja (https://github.com/mitsuhiko/minijinja).
Every text value from sandbox.toml or the host goes through `| q`, which writes it as a quoted
YAML string, so paths and values can't break the YAML. Numbers and true/false are validated
by the app and written as-is. Relative paths are relative to the .sandbox folder (--project-directory).
-#}
# Rendered from compose.yml.j2 with sandbox.toml and this machine's settings.
# Relative paths are relative to the .sandbox folder.
networks:
  sandbox:            # desktop <-> proxy/gateway; NO internet route
    internal: true
  egress: {}          # proxy -> internet
  ui: {}              # gateway -> published localhost port

x-hardened: &hardened
  read_only: true
  cap_drop: [ALL]
  security_opt: ["no-new-privileges:true"]
  restart: unless-stopped
  volumes:
    - .:/sandbox:ro   # allowlist.txt (live: "sandbox reload")

services:
  proxy:
    <<: *hardened
    build: ./.state/proxy
    command: ["tinyproxy", "-d", "-c", "/etc/tinyproxy/tinyproxy.conf"]
    networks: [sandbox, egress]
    extra_hosts:
      - "host.docker.internal:host-gateway"   # only reachable if allowlisted
    healthcheck:
      test: ["CMD", "nc", "-z", "127.0.0.1", "3128"]
      interval: 10s
      timeout: 3s
      retries: 3

  gateway:
    <<: *hardened
    build: ./.state/proxy
    command: ["socat", "TCP-LISTEN:3001,fork,reuseaddr", "TCP:desktop:3001"]
    networks: [sandbox, ui]
    ports:
      - {{ ("127.0.0.1:" ~ host.ui_port ~ ":3001") | q }}
    depends_on: [proxy]

  desktop:
    build:
      context: ./.state/desktop
      args:{{ " {}" if not tools else "" }}
      {% for t in tools %}
        {{ t.arg }}: {{ t.value | q }}
      {% endfor %}
    hostname: sandbox
    shm_size: 1gb
    labels:
      sandbox.id: {{ host.id | q }}
    environment:
      TITLE: {{ desktop.title | q }}
      SANDBOX_SUDO: {{ desktop.sudo | q }}
      {% if desktop.auth %}
      CUSTOM_USER: {{ desktop.auth.user | q }}
      PASSWORD: {{ desktop.auth.password | q }}
      {% endif %}
      HTTP_PROXY: http://proxy:3128
      HTTPS_PROXY: http://proxy:3128
      http_proxy: http://proxy:3128
      https_proxy: http://proxy:3128
      NO_PROXY: localhost,127.0.0.1,::1
      no_proxy: localhost,127.0.0.1,::1
      PUID: {{ host.uid | q }}
      PGID: {{ host.gid | q }}
      {% if desktop.timezone %}
      TZ: {{ desktop.timezone | q }}
      {% endif %}
      SANDBOX_WORKDIR: {{ host.workdir | q }}
      {% for e in env %}
      {{ e.key | q }}: {{ e.value | q }}
      {% endfor %}
    volumes:
      - home:/config            # persistent home: logins, IDE settings, Toolbox IDEs
      {% for m in mounts %}
      - {type: bind, source: {{ m.source | q }}, target: {{ m.target | q }}, read_only: {{ "true" if m.read_only else "false" }}}
      {% endfor %}
    {% if desktop.devices %}
    devices:
      {% for d in desktop.devices %}
      - {{ d | q }}
      {% endfor %}
    {% endif %}
    {% if desktop.security_opt %}
    security_opt:
      {% for o in desktop.security_opt %}
      - {{ o | q }}
      {% endfor %}
    {% endif %}
    networks: [sandbox]
    mem_limit: {{ desktop.memory | q }}
    {% if desktop.cpus %}
    cpus: {{ desktop.cpus }}
    {% endif %}
    pids_limit: 4096
    depends_on: [proxy]
    restart: unless-stopped
    healthcheck:
      # Ready = web UI answers AND the KDE shell is running (avoids the
      # "first page load fails" race when the browser opens too early).
      test: ["CMD-SHELL", "curl -skf -o /dev/null https://localhost:3001/ && pgrep -f plasmashell >/dev/null"]
      interval: 5s
      timeout: 5s
      retries: 3
      start_period: 180s

volumes:
  home:
