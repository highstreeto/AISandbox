#!/usr/bin/env bash
# Unified tool installer — used at image build time (INSTALL_* args in
# sandbox.yml) and at runtime inside the sandbox:
#
#   sandbox-install                  list tools and the hosts they need
#   sandbox-install vscode           install with defaults
#   sandbox-install dotnet 10.0 8.0  install with a version / options
#   sandbox-install bun false        no-op ("false" or "" = skip)
#
# Runtime installs go to the container filesystem and are lost on rebuild;
# put permanent tools into sandbox.yml instead.
set -euo pipefail
TOOLS=/usr/local/lib/sandbox/tools

if [ $# -eq 0 ]; then
  echo "Usage: sandbox-install <tool> [version|options]"
  echo
  for f in "$TOOLS"/*.sh; do
    n=$(basename "$f" .sh); [ "$n" = _lib ] && continue
    printf '  %-12s %s\n' "$n" "$(sed -n 's/^# ABOUT: //p' "$f")"
    printf '  %-12s hosts: %s\n' "" "$(sed -n 's/^# HOSTS: //p' "$f")"
  done
  exit 0
fi

tool=$1; shift
[ -f "$TOOLS/$tool.sh" ] || { echo "Unknown tool '$tool' (run sandbox-install to list)"; exit 1; }

# $# = 0 -> defaults; "true" -> defaults; ""/"false"/"no"/"0" -> skip
if [ $# -gt 0 ]; then
  case "$*" in
    ""|false|no|0) echo ">> $tool: skipped"; exit 0 ;;
    true|yes|1)    set -- ;;
  esac
fi

[ "$(id -u)" -eq 0 ] || exec sudo -E "$0" "$tool" "$@"
echo ">> Installing $tool $*"
# shellcheck disable=SC2068
exec bash "$TOOLS/$tool.sh" $@
